{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-novel-studio.local/schemas/v1/common.schema.json",
  "title": "Common registry v1",
  "$comment": "Editorial extension fields are permitted. Known operational fields are validated; cross-record references and approval semantics are checked separately.",
  "$defs": {
    "text": {
      "type": "string",
      "pattern": "\\S"
    },
    "id": {
      "type": "string",
      "pattern": "\\S"
    },
    "ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      }
    },
    "nullable_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "strings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "flags": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "provenance": {
      "type": "object",
      "required": ["repository", "pr_number", "head_commit", "merge_commit", "source_path", "source_sha256"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", "not": {"pattern": "\\s"}},
        "pr_number": {"type": "integer", "minimum": 1},
        "head_commit": {"type": "string", "minLength": 40, "maxLength": 40, "pattern": "^[0-9a-fA-F]{40}$"},
        "merge_commit": {"type": "string", "minLength": 40, "maxLength": 40, "pattern": "^[0-9a-fA-F]{40}$"},
        "source_path": {"$ref": "common.schema.json#/$defs/text"},
        "source_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-fA-F]{64}$"}
      },
      "$comment": "Declarations only. Remote observation requires an explicit online check; self-reported verification fields never establish approval.",
      "additionalProperties": true
    },
    "approval": {
      "type": "object",
      "required": [],
      "properties": {
        "pr_number": {
          "type": "integer",
          "minimum": 1
        },
        "approved_by": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "merge_commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": true
    }
  }
}
