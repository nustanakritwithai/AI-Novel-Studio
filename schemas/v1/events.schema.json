{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-novel-studio.local/schemas/v1/events.schema.json",
  "title": "Events registry v1",
  "$comment": "Editorial extension fields are permitted. Known operational fields are validated; cross-record references and approval semantics are checked separately.",
  "type": "object",
  "required": [
    "schema_version",
    "events"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "scene_id",
          "episode_id",
          "order",
          "location_id",
          "actors",
          "effects_flags"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "scene_id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "episode_id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "location_id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "actors": {
            "$ref": "common.schema.json#/$defs/ids"
          },
          "effects_flags": {
            "$ref": "common.schema.json#/$defs/flags"
          },
          "status": {
            "type": "string",
            "enum": [
              "PLANNED",
              "DRAFT",
              "REVIEW",
              "APPROVED",
              "CANON"
            ]
          },
          "what_changed": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
