{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-novel-studio.local/schemas/v1/decisions.schema.json",
  "title": "Decisions registry v1",
  "$comment": "Editorial extension fields are permitted. Known operational fields are validated; cross-record references and approval semantics are checked separately.",
  "type": "object",
  "required": [
    "schema_version",
    "decisions"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "summary",
          "status",
          "authority"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "summary": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "status": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "authority": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "canon_refs": {
            "$ref": "common.schema.json#/$defs/ids"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
