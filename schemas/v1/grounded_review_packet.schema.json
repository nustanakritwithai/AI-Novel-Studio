{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-novel-studio.local/schemas/v1/grounded_review_packet.schema.json",
  "title": "Source-bound grounded review packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "status", "story_slug", "target", "context_source_mode",
    "raw_draft", "scene_preparation", "git", "metadata_evidence", "human_editorial_approval",
    "canon_change_authorized", "ledger_apply_authorized", "packet_id"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "kind": {"type": "string", "const": "GROUNDED_REVIEW_PACKET"},
    "status": {"type": "string", "const": "PROPOSED"},
    "story_slug": {"type": "string", "minLength": 1, "maxLength": 63, "pattern": "\\S"},
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["scene_id", "draft_path"],
      "properties": {
        "scene_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "draft_path": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "\\S"}
      }
    },
    "context_source_mode": {"enum": ["working-tree", "committed"]},
    "raw_draft": {
      "type": "object", "additionalProperties": false,
      "required": ["origin", "path", "content", "sha256", "byte_length", "git_blob_id", "raw_status"],
      "properties": {
        "origin": {"type": "string", "const": "WORKING_TREE"},
        "path": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "\\S"},
        "content": {"type": "string"},
        "sha256": {"$ref": "#/\u0024defs/sha256"},
        "byte_length": {"type": "integer", "minimum": 0, "maximum": 1048576},
        "git_blob_id": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
        "raw_status": {"enum": ["MATCH", "DIFFERENT"]}
      }
    },
    "scene_preparation": {
      "type": "object", "additionalProperties": false,
      "required": ["content", "sha256"],
      "properties": {
        "content": {
          "type": "object",
          "required": ["schema_version", "kind", "status", "scene_cursor", "author_planning_context",
                       "source_evidence", "metadata_evidence"],
          "properties": {
            "schema_version": {"type": "integer", "const": 1},
            "kind": {"type": "string", "const": "SCENE_PREPARATION"},
            "status": {"type": "string", "const": "PROPOSED"},
            "scene_cursor": {"type": "object"},
            "author_planning_context": {"type": "object"},
            "source_evidence": {"type": "object"},
            "metadata_evidence": {"type": "object"}
          },
          "additionalProperties": true
        },
        "sha256": {"$ref": "#/\u0024defs/sha256"}
      }
    },
    "git": {
      "type": "object", "additionalProperties": false,
      "required": ["head_commit", "base_commit", "base_draft", "diff"],
      "properties": {
        "head_commit": {"$ref": "#/\u0024defs/commit"},
        "base_commit": {"$ref": "#/\u0024defs/commit"},
        "base_draft": {
          "type": "object", "additionalProperties": false,
          "required": ["availability", "sha256", "byte_length", "git_blob_id"],
          "properties": {
            "availability": {"enum": ["AVAILABLE", "MISSING", "UNKNOWN"]},
            "sha256": {"oneOf": [{"$ref": "#/\u0024defs/sha256"}, {"type": "null"}, {"type": "string", "const": "UNKNOWN"}]},
            "byte_length": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "null"}, {"type": "string", "const": "UNKNOWN"}]},
            "git_blob_id": {"oneOf": [{"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"}, {"type": "null"}, {"type": "string", "const": "UNKNOWN"}]}
          }
        },
        "diff": {
          "type": "object", "additionalProperties": false,
          "required": ["availability", "content", "sha256", "byte_length"],
          "properties": {
            "availability": {"enum": ["AVAILABLE", "UNKNOWN"]},
            "content": {"type": "string"},
            "sha256": {"oneOf": [{"$ref": "#/\u0024defs/sha256"}, {"type": "string", "const": "UNKNOWN"}]},
            "byte_length": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "string", "const": "UNKNOWN"}]}
          }
        }
      }
    },
    "metadata_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["basis", "sha256", "files"],
      "properties": {
        "basis": {"type": "string", "const": "WORKING_TREE_REGISTRIES"},
        "sha256": {"$ref": "#/\u0024defs/sha256"},
        "files": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {"type": "null"},
              {"type": "object", "additionalProperties": false,
               "required": ["sha256", "byte_length"],
               "properties": {"sha256": {"$ref": "#/\u0024defs/sha256"},
                              "byte_length": {"type": "integer", "minimum": 0}}}
            ]
          }
        }
      }
    },
    "human_editorial_approval": {"type": "string", "const": "UNVERIFIED"},
    "canon_change_authorized": {"type": "boolean", "const": false},
    "ledger_apply_authorized": {"type": "boolean", "const": false},
    "packet_id": {"$ref": "#/\u0024defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "minLength": 64, "maxLength": 64,
                "pattern": "^[0-9a-f]{64}$", "not": {"pattern": "[^0-9a-f]"}},
    "commit": {"oneOf": [
      {"type": "string", "const": "UNKNOWN"},
      {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"}
    ]}
  }
}
