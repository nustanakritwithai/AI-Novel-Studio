{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-novel-studio.local/schemas/v1/state_history.schema.json",
  "title": "Local declared state history v1 (not GitHub-authenticated approval)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "baseline", "deltas"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "baseline": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["before_scene", "status", "evidence_path", "state"],
          "properties": {
            "before_scene": {"$ref": "#/$defs/nonempty"},
            "status": {"$ref": "#/$defs/local_status"},
            "evidence_path": {"$ref": "#/$defs/nonempty"},
            "state": {"type": "object"}
          }
        }
      ]
    },
    "deltas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "scene_id", "status", "changes"],
        "properties": {
          "id": {"$ref": "#/$defs/nonempty"},
          "scene_id": {"$ref": "#/$defs/nonempty"},
          "status": {"$ref": "#/$defs/local_status"},
          "changes": {"type": "array", "items": {"$ref": "#/$defs/change"}}
        }
      }
    }
  },
  "$defs": {
    "nonempty": {"type": "string", "pattern": "\\S"},
    "local_status": {"enum": ["PROPOSED", "APPROVED"]},
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "operation", "before_exists"],
      "properties": {
        "path": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonempty"}},
        "operation": {"enum": ["SET", "REMOVE"]},
        "before_exists": {"type": "boolean"},
        "before": {},
        "value": {}
      },
      "allOf": [
        {
          "if": {"properties": {"before_exists": {"const": true}}},
          "then": {"required": ["before"]},
          "else": {"not": {"required": ["before"]}}
        },
        {
          "if": {"properties": {"operation": {"const": "SET"}}},
          "then": {"required": ["value"]},
          "else": {"properties": {"before_exists": {"const": true}}, "not": {"required": ["value"]}}
        }
      ]
    }
  }
}
