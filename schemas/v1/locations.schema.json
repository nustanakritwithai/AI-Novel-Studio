{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-novel-studio.local/schemas/v1/locations.schema.json",
  "title": "Locations registry v1",
  "$comment": "Editorial extension fields are permitted. Known operational fields are validated; cross-record references and approval semantics are checked separately.",
  "type": "object",
  "required": [
    "schema_version",
    "locations"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "locations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "name": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "realm": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "$ref": "common.schema.json#/$defs/text"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
