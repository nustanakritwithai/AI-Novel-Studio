{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-novel-studio.local/schemas/v1/threads.schema.json",
  "title": "Threads registry v1",
  "$comment": "Editorial extension fields are permitted. Known operational fields are validated; cross-record references and approval semantics are checked separately.",
  "type": "object",
  "required": [
    "schema_version",
    "threads"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "threads": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "status"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "title": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "status": {
            "type": "string",
            "enum": [
              "IDEA",
              "OPEN",
              "PLANNED",
              "RESOLVED"
            ]
          },
          "priority": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "setup_scene_id": {
            "$ref": "common.schema.json#/$defs/nullable_id"
          },
          "payoff_scene_id": {
            "$ref": "common.schema.json#/$defs/nullable_id"
          },
          "owner_character_id": {
            "$ref": "common.schema.json#/$defs/nullable_id"
          },
          "canon_refs": {
            "$ref": "common.schema.json#/$defs/ids"
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
