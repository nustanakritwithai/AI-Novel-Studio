{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-novel-studio.local/schemas/world_state/world_history.schema.json",
  "title": "S2 proposed world-state history v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "story_slug",
    "model_sha256",
    "baseline_id",
    "baseline_boundary",
    "coverage",
    "deltas"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "story_slug": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "not": {
        "pattern": "[^a-z0-9-]"
      }
    },
    "model_sha256": {
      "$ref": "common.schema.json#/$defs/source/properties/sha256"
    },
    "baseline_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "baseline_boundary": {
      "enum": [
        "BEFORE",
        "AFTER"
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "through",
        "local_status",
        "source"
      ],
      "properties": {
        "through": {
          "$ref": "#/$defs/cursor"
        },
        "local_status": {
          "enum": [
            "PROPOSED",
            "APPROVED"
          ]
        },
        "source": {
          "$ref": "common.schema.json#/$defs/source"
        }
      }
    },
    "deltas": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "metadata": {
      "type": "object",
      "description": "Opaque operational metadata; never establishes history facts or approval."
    }
  },
  "$defs": {
    "cursor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clock_id",
        "tick",
        "suborder",
        "boundary"
      ],
      "properties": {
        "clock_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "tick": {
          "type": "integer"
        },
        "suborder": {
          "type": "integer",
          "minimum": 0
        },
        "boundary": {
          "enum": [
            "BEFORE",
            "AFTER"
          ]
        }
      }
    },
    "known_holder": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "character_id"
          ],
          "properties": {
            "kind": {
              "const": "CHARACTER"
            },
            "character_id": {
              "$ref": "common.schema.json#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "location_id"
          ],
          "properties": {
            "kind": {
              "const": "LOCATION"
            },
            "location_id": {
              "$ref": "common.schema.json#/$defs/id"
            }
          }
        }
      ]
    },
    "move": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "character_id",
        "from_location_id",
        "to_location_id"
      ],
      "properties": {
        "operation": {
          "const": "MOVE_CHARACTER"
        },
        "character_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "from_location_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "to_location_id": {
          "$ref": "common.schema.json#/$defs/id"
        }
      }
    },
    "transfer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "item_id",
        "from_holder",
        "to_holder",
        "quantity"
      ],
      "properties": {
        "operation": {
          "const": "TRANSFER_ITEM"
        },
        "item_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "from_holder": {
          "$ref": "#/$defs/known_holder"
        },
        "to_holder": {
          "$ref": "#/$defs/known_holder"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "operation": {
      "oneOf": [
        {
          "$ref": "#/$defs/move"
        },
        {
          "$ref": "#/$defs/transfer"
        }
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "anchor",
        "local_status",
        "source",
        "operations"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "anchor": {
          "$ref": "common.schema.json#/$defs/anchor"
        },
        "local_status": {
          "enum": [
            "PROPOSED",
            "APPROVED"
          ]
        },
        "source": {
          "$ref": "common.schema.json#/$defs/source"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/operation"
          }
        }
      }
    }
  }
}
