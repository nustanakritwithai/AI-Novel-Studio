{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Story configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "slug", "title", "extensions", "rules"],
  "properties": {
    "schema_version": {"const": 1, "type": "integer"},
    "slug": {"type": "string", "maxLength": 63, "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "not": {"enum": ["con", "prn", "aux", "nul", "com1", "com2", "com3", "com4", "com5", "com6", "com7", "com8", "com9", "lpt1", "lpt2", "lpt3", "lpt4", "lpt5", "lpt6", "lpt7", "lpt8", "lpt9"]}},
    "title": {"type": "string", "pattern": "\\S"},
    "extensions": {"type": "object", "additionalProperties": false, "required": ["gameplay"], "properties": {"gameplay": {"type": "boolean"}}},
    "rules": {"type": "array", "items": {"type": "string", "pattern": "\\S"}},
    "world_state": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "enabled"],
      "properties": {"schema_version": {"const": 1, "type": "integer"}, "enabled": {"type": "boolean"}}
    }
  }
}
